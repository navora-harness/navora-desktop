{
  "name": "navora",
  "version": "0.3.38",
  "private": true,
  "license": "MIT",
  "author": "Navora",
  "description": "AI Agent Browser - Chat-driven browser automation on unofficial Electron",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run electron:install && npm run typecheck && npm test && vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "test:store": "node scripts/test-marketplace.mjs",
    "test:plugins:platform": "node scripts/plugin-platform-smoke.mjs",
    "test:browser": "npm run electron:install && node scripts/browser-smoke.mjs",
    "test:browser:pointer": "npm run electron:install && node scripts/pointer-smoke.mjs",
    "test:ui:browser:automation": "vite build && node scripts/ui-browser-automation.mjs",
    "test:ui:browser": "npm run build && node scripts/ui-browser-workspace.mjs",
    "test:ui:framework": "npm run build && node scripts/ui-main-window.mjs",
    "test:ui:browser:recovery": "npm run build && node scripts/ui-browser-recovery.mjs",
    "test:ui:browser:start": "npm run build && node scripts/ui-browser-start.mjs",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs",
    "test:ui:renovation": "npm run build && node scripts/ui-renovation.mjs",
    "test:ui:interface": "npm run build && node scripts/ui-interface.mjs",
    "test:ui:creators": "npm run build && node scripts/ui-creators.mjs",
    "test:ui:plugins": "npm run build && node scripts/ui-plugins.mjs",
    "electron:dev": "npm run electron:install && node scripts/dev.mjs",
    "electron:use-build": "node scripts/use-electron-build.mjs",
    "electron:install": "node scripts/install-cloudbypass-electron.mjs",
    "start": "npm run electron:install && electron .",
    "dist": "npm run build && npm run test:browser && electron-builder --win portable",
    "dist:nsis": "npm run build && npm run test:browser && electron-builder --win nsis",
    "dist:mac": "npm run build && npm run test:browser && electron-builder --mac",
    "dist:linux": "npm run build && npm run test:browser && electron-builder --linux",
    "dist:all": "npm run build && npm run test:browser && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.navora.app",
    "productName": "Navora",
    "copyright": "Copyright (c) Navora",
    "directories": {
      "output": "release"
    },
    "icon": "electron/assets/app-icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/main.js.map",
      "dist-electron/preload.js",
      "dist-electron/preload.js.map",
      "dist-electron/plugin-dev-prompt.md",
      "dist-electron/assets/**/*",
      "dist-electron/bundled-plugins/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "icon": "electron/assets/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/assets/app-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "electron/assets/app-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Navora",
      "uninstallDisplayName": "Navora",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@postpile/ui": "file:vendor/postpile-ui-0.1.2.tgz",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/vue-3": "3.32.2",
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.15",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.12",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/adm-zip": "^0.5.8",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "https://github.com/ChengHoward/edist/releases/download/v45.0.0-cloudbypass.5/electron-45.0.0-cloudbypass.5.tgz",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue-tsc": "^2.2.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
